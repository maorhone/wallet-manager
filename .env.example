# Copy to .env (gitignored). Run `uv run python scripts/dev_db.py` to get the DB URLs.
DATABASE_URL=
LITELLM_BASE_URL=http://localhost:4102
LITELLM_MASTER_KEY=sk-dev-master
LITELLM_DATABASE_URL=
APP_TIMEZONE=Asia/Jerusalem
DEV_AUTH=1
SEED_FILE=seed/dev.yaml
SESSION_SECRET=change-me
COOKIE_SECURE=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_UPN_CLAIM=upn
OIDC_NAME_CLAIM=name
OIDC_GROUPS_CLAIM=groups
JWT_ISSUER=
# Onboarding portal (SPEC 9.2). Lists are JSON. Empty ONBOARDING_USER_AUDIENCES disables /onboarding.
ADFS_JWKS_URL=https://adfs.corp.example/adfs/discovery/keys
ADFS_ISSUER=https://adfs.corp.example/adfs
ONBOARDING_AUDIENCE=
ONBOARDING_CLIENT_IDS=[]
ONBOARDING_USER_AUDIENCES=[]
# Shown in the install snippet (ANTHROPIC_BASE_URL); the fake LiteLLM in dev.
LITELLM_PUBLIC_URL=https://litellm.corp.example
# Dev only: HS256 signing secret for local tokens. The API refuses to start with it unless DEV_AUTH=1.
DEV_JWT_SECRET=
OUTBOX_POLL_S=1
SPEND_SNAPSHOT_INTERVAL_S=300
OVERALLOC_INTERVAL_S=300
# Scheduler (python -m app.scheduler)
SCHEDULER_GRANTS_INTERVAL_S=60
SCHEDULER_NOTIFY_INTERVAL_S=900
RECONCILE_INTERVAL_MIN=5
SCHEDULER_LOCK_TIMEOUT_S=300
