{
  "permissions": {"deny": ["Bash(sudo *)", "Bash(tailscale *)", "Bash(cloudflared *)", "Bash(git push)", "Bash(git push *)", "Bash(gh repo delete *)", "Bash(gh issue create --repo *)", "Edit(.claude/hooks/**)", "Write(.claude/hooks/**)", "Edit(.claude/settings*.json)", "Write(.claude/settings*.json)"]},
  "hooks": {
    "PreToolUse": [{"matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Grep", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh", "timeout": 20, "onFailure": "block"}]}],
    "PostToolUse": [{"matcher": "Edit|Write|MultiEdit", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh", "timeout": 90}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-tests.sh", "timeout": 600}]}],
    "StopFailure": [{"hooks": [{"type": "command", "command": "mkdir -p \"$CLAUDE_PROJECT_DIR\"/.claude/state && cat > \"$CLAUDE_PROJECT_DIR\"/.claude/state/last-stop-failure.json"}]}]
  }
}
